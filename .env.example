# Browser-safe configuration only. Never put service-role/provider secrets in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
# fixtures is available only in Vite development, never in production builds.
VITE_API_MODE=live

# Supabase Edge Function secrets (set separately using supabase secrets set).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.
# APP_ORIGIN=https://your-domain.example
# TURNSTILE_SECRET_KEY=
# TURNSTILE_EXPECTED_HOSTNAME=your-domain.example
# RATE_LIMIT_SALT=<random secret of at least 32 characters>
